{
  "schema_version": 1,
  "workspace": {
    "projects_dir": "projects",
    "shared_dir": "shared",
    "templates_dir": "templates",
    "ui_dir": "ui"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8931,
    "default_project": "demo",
    "open_browser": true
  },
  "user": {
    "name": "",
    "language": "auto",
    "units": "mm",
    "theme": "auto"
  },
  "altium": {
    "install_path": ""
  },
  "agent": {
    "provider": "claude_code",
    "engine_home": "",
    "timeout_seconds": 180,
    "history_messages": 8,
    "memory_every": 10,
    "memory_max_chars": 2000,
    "providers": {
      "claude_code": {
        "enabled": true,
        "command": "claude",
        "args": [
          "-p",
          "-",
          "--output-format",
          "text"
        ],
        "model": "",
        "tools": {
          "available": null,
          "allowed": [
            "Read",
            "Skill",
            "Grep",
            "Glob",
            "WebSearch",
            "WebFetch",
            "Bash({python} {repo}/scripts/trace_width.py *)",
            "Bash({python} {repo}/scripts/sources.py *)",
            "Bash({python} {repo}/scripts/model.py *)",
            "Edit({projects_rule}/*/notes.md)",
            "Edit({projects_rule}/*/BOM.md)",
            "Edit({projects_rule}/*/BOM.csv)",
            "Edit({projects_rule}/*/sources/*.md)",
            "Edit({projects_rule}/*/sources/*.md.json)",
            "Bash({python} {repo}/scripts/skills/*.py *)",
            "Bash({python} {repo}/scripts/verify_sources.py *)"
          ],
          "disallowed": [
            "NotebookEdit"
          ],
          "permission_mode": null
        }
      },
      "external": {
        "enabled": true
      },
      "codex": {
        "enabled": false,
        "command": "codex",
        "args": [],
        "model": ""
      },
      "antigravity": {
        "enabled": true,
        "command": "agy",
        "args": [
          "-p",
          "-",
          "--output-format",
          "text",
          "--dangerously-skip-permissions"
        ],
        "model": "",
        "effort": null
      },
      "openai_api": {
        "enabled": false,
        "base_url": "",
        "model": "",
        "api_key_env": "OPENAI_API_KEY"
      }
    }
  },
  "engineering_defaults": {
    "layers": 2,
    "copper_oz": 1.0,
    "trace_layer": "external",
    "ambient_c": 25,
    "max_temp_rise_c": 10,
    "min_track_mm": 0.2,
    "min_clearance_mm": 0.2,
    "min_via_drill_mm": 0.3,
    "board_finish": "HASL",
    "assembly": "reflow"
  }
}
