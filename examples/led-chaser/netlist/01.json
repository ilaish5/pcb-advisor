  "notes": [
    {
      "section": "CLK",
      "text": "f = 1.44 / ((R1 + 2*R2) * C1), about 2.1 Hz. THR and TRIG are one net."
    },
    {
      "section": "LED",
      "text": "All cathodes meet at LED_K; one LED is on at a time, so one resistor is enough."
    }
  ]
