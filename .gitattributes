* text=auto eol=lf
*.pdf binary
*.png binary
*.zip binary

# Altium files: keep byte-exact (OLE binaries; PrjPcb/OutJob are CRLF text Altium writes itself)
*.SchDoc binary
*.PcbDoc binary
*.SchLib binary
*.PcbLib binary
*.IntLib binary
*.PrjPcb -text
*.OutJob -text
*.RUL -text
*.bat text eol=crlf
*.pas text eol=crlf
*.PrjScr text eol=crlf

# Vendored third-party code: byte-exact, so the SHA-256 list in ui/vendor/README.md holds for every checkout
ui/vendor/** -text
