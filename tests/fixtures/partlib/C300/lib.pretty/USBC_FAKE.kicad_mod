(module "easyeda2kicad:USBC_FAKE" (layer F.Cu)
  (pad 1 smd rect (at -1 0 0) (size 0.6 1.0) (layers F.Cu))
  (pad 2 smd rect (at 1 0 0) (size 0.6 1.0) (layers F.Cu))
  (pad "S1" thru_hole oval (at 3 0 0) (size 1.0 1.8) (drill oval 0.6 1.4) (layers *.Cu *.Mask))
  (model "x/USBC_FAKE.wrl" (offset (xyz 0 0 0)) (rotate (xyz 0 0 0)))
)
