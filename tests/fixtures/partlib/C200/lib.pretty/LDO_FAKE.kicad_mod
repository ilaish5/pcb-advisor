(module LDO_FAKE (layer F.Cu)
  (pad 1 smd rect (at -1 -0.95 0) (size 0.9 0.8) (layers F.Cu))
  (pad 2 smd rect (at -1 0.95 0) (size 0.9 0.8) (layers F.Cu))
  (pad 3 smd roundrect (at 1 0 0) (size 0.9 0.8) (layers F.Cu) (roundrect_rratio 0.25))
  (fp_circle (center -1.5 -1.5) (end -1.4 -1.5) (layer F.SilkS) (width 0.12))
  (model "${EASYEDA2KICAD}/lib.3dshapes/LDO_FAKE.wrl" (offset (xyz 0 0 0)) (rotate (xyz 0 0 0)))
)
